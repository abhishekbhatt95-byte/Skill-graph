# SkillGraph AI — Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual project keys

# Supabase Client Configuration (Required for React / Vite client)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Optional fallback for legacy configurations
# VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Application Settings
STORAGE_BUCKET_NAME="skillgraph-private-resumes"
